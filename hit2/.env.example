# Copiar a .env (que no se versiona) y completar. chmod 600 .env si lleva el token.

# Grupo dueño del socket de Docker en ESTE host: stat -c %g /var/run/docker.sock
DOCKER_GID=

# Imágenes que el servidor acepta ejecutar, separadas por comas (p. ej. cerberusdistribuido/tarea).
# Con @sha256:<digest> (cerberusdistribuido/tarea@sha256:...) sólo se acepta ese contenido.
# Vacía = no se ejecuta nada.
TP2_IMAGENES_PERMITIDAS=

TP2_PUERTO=8082
TP2_TIMEOUT_EJECUCION=60
TP2_WORKERS_MAX=4
TP2_TAREA_MEM_LIMIT=256m
TP2_TAREA_CPUS=1.0

# Registry privado (la imagen de la tarea lo es). Usar un token de acceso de
# Docker Hub de SÓLO LECTURA, nunca la contraseña. En la VM va sólo en este archivo.
TP2_REGISTRY_USUARIO=
TP2_REGISTRY_TOKEN=

# Token de autenticación para clientes (R4/R5). Vacío = no exige autenticación.
TP2_API_TOKEN=

# Sólo en la VM del despliegue: la imagen que publica el CI.
# TP2_IMAGEN=ghcr.io/chimera-sdypp/sdypp_tp2-hit2:latest

