# Copiar a .env (que no se versiona) y completar. chmod 600 .env si lleva el token.

# Grupo dueño del socket de Docker en ESTE host: stat -c %g /var/run/docker.sock
DOCKER_GID=

# Imágenes que el servidor acepta ejecutar, separadas por comas (p. ej. cerberusdistribuido/tarea).
# Vacía = no se ejecuta nada.
TP2_IMAGENES_PERMITIDAS=

TP2_PUERTO=8080
TP2_TIMEOUT_EJECUCION=60

# Registry privado (opcional). Usar un token de acceso de Docker Hub de SÓLO
# LECTURA, nunca la contraseña. En el deploy lo inyecta el CD desde GitHub Secrets.
TP2_REGISTRY_USUARIO=
TP2_REGISTRY_TOKEN=
